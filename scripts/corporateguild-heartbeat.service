[Unit]
Description=CorporateGuild Worker Node Telemetry Heartbeat Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/iamrj846.github.io
ExecStart=/usr/bin/python3 /home/ubuntu/iamrj846.github.io/scripts/worker_node_heartbeat.py
Restart=always
RestartSec=10
EnvironmentFile=-/home/ubuntu/iamrj846.github.io/.env.prod
EnvironmentFile=-/home/ubuntu/iamrj846.github.io/.env

[Install]
WantedBy=multi-user.target
