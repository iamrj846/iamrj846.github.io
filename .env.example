# CorporateGuild Environment Configuration Example
# Copy to .env.local for local development, or .env.prod for production

# Target Environment: 'local' or 'production'
APP_ENV=local

# Application Secrets & Admin Access
ADMIN_USERNAME=iamrj846
ADMIN_PASSWORD=iamrj846
COOKIE_SECRET=your-secret-cookie-key-here-minimum-32-chars
SECRET_KEY=your-jwt-secret-key-here-minimum-32-chars

# Database & Storage
DATABASE_PATH=data/jobs_portal.db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=604800

# Server Settings
# Use 127.0.0.1 for local, 0.0.0.0 for production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=True
TIMEZONE=Asia/Kolkata
SYNC_INTERVAL_MINUTES=10
