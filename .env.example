# CorporateGuild Environment Configuration Example
# Copy this file to .env or .env.local to configure credentials

# Environment & Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=False
TIMEZONE=Asia/Kolkata

# Admin & Authentication Credentials (Use strong secrets in real .env)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password
COOKIE_SECRET=your-random-cookie-secret-key-32-chars
SECRET_KEY=your-random-jwt-secret-key-32-chars

# Contact Form Email Dispatch (FormSubmit)
FORMSUBMIT_TOKEN=your-formsubmit-token-here

# Database & Storage
DATABASE_PATH=data/jobs_portal.db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=604800
SYNC_INTERVAL_MINUTES=10

# SMTP Email Configuration for Live OTP Verification
# For Gmail: Use smtp.gmail.com (port 587) with your 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password-here
SMTP_FROM_EMAIL=CorporateGuild <your-email@gmail.com>
SMTP_USE_TLS=true
