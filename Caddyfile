# ==============================================================================
# CorporateGuild - Production Caddy Web Server & Reverse Proxy Configuration
# ==============================================================================
# Caddy automatically provisions and renews SSL/TLS certificates via Let's Encrypt
# for the specified domains with zero manual certbot intervention.
# Uses active-active upstream load balancing with active health checks
# between VM 1 (Gateway, web:8000) and VM 2 (Worker, 10.0.0.12:8000).
# ==============================================================================

# Global Configuration
{
    email admin@corporateguild.com
    log {
        output stdout
        format console
        level INFO
    }
}

# Redirect www to apex domain (canonical URL)
www.corporateguild.com {
    redir https://corporateguild.com{uri} permanent
}

# Primary Production Domain
corporateguild.com {
    encode zstd gzip

    # Production Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Pin State-Mutating Auth routes directly to Primary Gateway Node (Master SQLite)
    @auth {
        path /api/auth/*
    }
    reverse_proxy @auth web:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }

    # Pin Administrative Operations & Portal directly to Primary Gateway Node
    @admin {
        path /admin /admin.html /api/admin/*
    }
    reverse_proxy @admin web:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }

    # Active-Active Load Balanced Reverse Proxy across VM 1 and VM 2 for Search & Listings
    reverse_proxy web:8000 10.0.0.12:80 {
        lb_policy round_robin
        lb_try_duration 15s
        lb_try_interval 250ms

        health_uri /api/health
        health_interval 10s
        health_timeout 3s
        health_status 200

        transport http {
            dial_timeout 10s
            response_header_timeout 60s
        }
    }
}

# Direct IP fallback / Health Check
:80 {
    # Pin State-Mutating Auth routes directly to Primary Gateway Node
    @auth {
        path /api/auth/*
    }
    reverse_proxy @auth web:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }

    # Pin Administrative Operations & Portal directly to Primary Gateway Node
    @admin {
        path /admin /admin.html /api/admin/*
    }
    reverse_proxy @admin web:8000 {
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }

    reverse_proxy web:8000 10.0.0.12:80 {
        lb_policy round_robin
        lb_try_duration 5s
        lb_try_interval 250ms

        health_uri /api/health
        health_interval 10s
        health_timeout 3s
        health_status 200

        transport http {
            dial_timeout 5s
            response_header_timeout 60s
        }
    }
}
